# Shared version pins for cluster-wide add-ons installed by both `make
# install-e2e-deps` and hack/generate-screenshots.sh, so the two never drift
# out of sync. Valid as both a Makefile `include` and a bash `source` file --
# keep it to plain VAR=value lines only.
GATEWAY_API_VERSION=v1.6.0
CERT_MANAGER_VERSION=v1.21.0
CROSSPLANE_VERSION=2.3.3
EXTERNAL_SNAPSHOTTER_VERSION=v8.2.0
KARPENTER_VERSION=v1.14.0
FLUX_VERSION=v2.9.3
ISTIO_VERSION=1.30.3
KYVERNO_VERSION=3.8.2
GATEKEEPER_VERSION=v3.23.0
METRICS_SERVER_VERSION=3.14.0
# The kind CLI version CI installs (helm/kind-action's `version` input) -- pinned
# rather than taking the action's default, which currently lags at v0.31.0 and
# would silently pick a k8s 1.35.x node image. Bump this and KIND_NODE_IMAGE
# together; a node image is only supported by the kind release that published it.
KIND_VERSION=v0.32.0
# Digest-pinned so a retag upstream can't change what the e2e suite renders
# against. v1.36.1 is kind v0.32.0's default node image and matches the
# k8s.io/client-go v0.36.x this repo builds against.
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
