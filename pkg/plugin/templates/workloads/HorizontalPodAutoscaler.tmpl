{{- define "HorizontalPodAutoscaler" }}
    {{- /*gotype: github.com/bergerx/kubectl-status/pkg/plugin.RenderableObject*/ -}}
    {{- /* GVK: autoscaling/v2, Kind=HorizontalPodAutoscaler */ -}}
    {{- template "status_summary_line" . }}{{- with .Status.lastScaleTime }}, last scaled {{ . | colorAgo }}{{ agoSuffix }}{{- end }}
    {{- template "kstatus_summary" . }}
    {{- template "finalizer_details_on_termination" . }}
    {{- template "observed_generation_summary" . }}
    {{- with .Spec.scaleTargetRef }}
        {{- if $.Config.GetBool "deep" }}
            {{- $obj := $.KubeGetFirst $.Namespace (qualifyKind (.kind | default "Deployment") .apiVersion) .name }}
            {{- if $obj.Object }}{{ $.IncludeRenderableObject $obj | nindent 2 }}{{ end }}
        {{- else }}
            {{- "Scales" | bold | nindent 2 }}: {{ $.Include "resource_ref" (dict "kind" (.kind | default "Deployment") "name" .name "group" .apiVersion) }}
        {{- end }}
    {{- end }}
    {{- $minReplicas := 1 }}{{- if .Spec | hasKey "minReplicas" }}{{- $minReplicas = .Spec.minReplicas | toInt }}{{- end }}
    {{- $current := .Status.currentReplicas | default 0 | toInt }}
    {{- $desired := .Status.desiredReplicas | default 0 | toInt }}
    {{- "Replicas" | bold | nindent 2 }}: {{ printf "%d" $current | redBoldIf (ne $current $desired) }}/{{ printf "%d-%d" $minReplicas (.Spec.maxReplicas | toInt) }}
    {{- if ne $current $desired }}, {{ "desired" | yellow | bold }}: {{ printf "%d" $desired | yellow }}{{ end }}
    {{- /* ScalingLimited is polarity-inverted: False is the normal case (which the generic
           normal-polarity heuristic paints red -- a false alarm on every healthy HPA), and
           True means the HPA is pinned at a spec bound -- noteworthy, not faulty. Rendered
           explicitly here and excluded from the generic condition dump below. */ -}}
    {{- $scalingLimited := getMatchingItemInMapList (dict "type" "ScalingLimited") .StatusConditions }}
    {{- if $scalingLimited }}{{ if eq ($scalingLimited.status | default "" | toString) "True" }}
        {{- $line := "Scaling limited" | yellow | bold }}
        {{- with $scalingLimited.reason }}{{ $line = printf "%s (%s)" $line . }}{{ end }}
        {{- with $scalingLimited.message }}{{ $line = printf "%s, %s" $line . }}{{ end }}
        {{- $line | yellow | nindent 2 }}
    {{- end }}{{ end }}
    {{- with .Spec.metrics }}
        {{- "Metrics" | bold | nindent 2 }}:
        {{- range . }}
            {{- $spec := . }}
            {{- $cur := dict }}
            {{- range $.Status.currentMetrics }}
                {{- if eq .type $spec.type }}
                    {{- if eq .type "Resource" }}{{ if eq .resource.name $spec.resource.name }}{{ $cur = . }}{{ end }}{{ end }}
                    {{- if eq .type "ContainerResource" }}{{ if and (eq .containerResource.name $spec.containerResource.name) (eq .containerResource.container $spec.containerResource.container) }}{{ $cur = . }}{{ end }}{{ end }}
                    {{- if eq .type "Pods" }}{{ if eq .pods.metric.name $spec.pods.metric.name }}{{ $cur = . }}{{ end }}{{ end }}
                    {{- if eq .type "Object" }}{{ if eq .object.metric.name $spec.object.metric.name }}{{ $cur = . }}{{ end }}{{ end }}
                    {{- if eq .type "External" }}{{ if eq .external.metric.name $spec.external.metric.name }}{{ $cur = . }}{{ end }}{{ end }}
                {{- end }}
            {{- end }}
            {{- if eq .type "Resource" }}
                {{- $target := .resource.target }}
                {{- .resource.name | nindent 4 }}:
                {{- if eq $target.type "Utilization" }}
                    {{- $targetUtil := $target.averageUtilization | toInt }}
                    {{- if ($cur.resource.current | default dict) | hasKey "averageUtilization" }}
                        {{- $curUtil := $cur.resource.current.averageUtilization | toInt }}
                        {{- $curUtil | toString | redIf (ge $curUtil $targetUtil) }}%/
                    {{- end }}{{ $targetUtil | toString }}%
                {{- else if eq $target.type "AverageValue" }}
                    {{- with ($cur.resource.current | default dict).averageValue }}{{ . | cyan }}/{{ end }}{{ $target.averageValue | cyan }}
                {{- else }}
                    {{- with ($cur.resource.current | default dict).value }}{{ . | cyan }}/{{ end }}{{ $target.value | cyan }}
                {{- end }}
            {{- else if eq .type "ContainerResource" }}
                {{- $target := .containerResource.target }}
                {{- printf "%s[%s]" .containerResource.name .containerResource.container | nindent 4 }}:
                {{- if eq $target.type "Utilization" }}
                    {{- $targetUtil := $target.averageUtilization | toInt }}
                    {{- if ($cur.containerResource.current | default dict) | hasKey "averageUtilization" }}
                        {{- $curUtil := $cur.containerResource.current.averageUtilization | toInt }}
                        {{- $curUtil | toString | redIf (ge $curUtil $targetUtil) }}%/
                    {{- end }}{{ $targetUtil | toString }}%
                {{- else if eq $target.type "AverageValue" }}
                    {{- with ($cur.containerResource.current | default dict).averageValue }}{{ . | cyan }}/{{ end }}{{ $target.averageValue | cyan }}
                {{- else }}
                    {{- with ($cur.containerResource.current | default dict).value }}{{ . | cyan }}/{{ end }}{{ $target.value | cyan }}
                {{- end }}
            {{- else if eq .type "Pods" }}
                {{- .pods.metric.name | nindent 4 }}:
                {{- with ($cur.pods.current | default dict).averageValue }}{{ . | cyan }}/{{ end }}{{ .pods.target.averageValue | cyan }} avg/pod
            {{- else if eq .type "Object" }}
                {{- printf "%s/%s %s" .object.describedObject.kind .object.describedObject.name .object.metric.name | nindent 4 }}:
                {{- if eq (.object.target.type | default "Value") "AverageValue" }}
                    {{- with ($cur.object.current | default dict).averageValue }}{{ . | cyan }}/{{ end }}{{ .object.target.averageValue | cyan }} avg
                {{- else }}
                    {{- with ($cur.object.current | default dict).value }}{{ . | cyan }}/{{ end }}{{ .object.target.value | cyan }}
                {{- end }}
            {{- else if eq .type "External" }}
                {{- .external.metric.name | nindent 4 }}:
                {{- if eq (.external.target.type | default "Value") "AverageValue" }}
                    {{- with ($cur.external.current | default dict).averageValue }}{{ . | cyan }}/{{ end }}{{ .external.target.averageValue | cyan }} avg
                {{- else }}
                    {{- with ($cur.external.current | default dict).value }}{{ . | cyan }}/{{ end }}{{ .external.target.value | cyan }}
                {{- end }}
            {{- end }}
        {{- end }}
    {{- end }}
    {{- /* Same dump conditions_summary does, minus ScalingLimited -- handled explicitly
           above, since its inverted polarity reads backwards to the generic heuristic.
           Whitespace mirrors conditions_summary's body so each condition lands on its
           own line. */ -}}
    {{- range .StatusConditions }}
        {{- if and (ne .type "ScalingLimited") (or .type .reason .message) }}
  {{ template "condition_summary" . }}
        {{- end }}
    {{- end }}
    {{- template "application_details" . }}
    {{- template "recent_updates" . }}
    {{- template "events" . }}
    {{- template "owners" . }}
{{- end -}}

{{- define "HorizontalPodAutoscaler.summary" }}
    {{- /*gotype: github.com/bergerx/kubectl-status/pkg/plugin.RenderableObject*/ -}}
    {{- /* Expects dict "obj" (HorizontalPodAutoscaler RenderableObject) "callerNamespace" (optional
           -- forwarded to resource_ref so obj's own namespace is dropped from the summary when
           it's redundant, same contract every "<Kind>.summary" template uses). */ -}}
    {{- $obj := .obj }}
    {{- template "resource_ref" (dict "kind" $obj.Kind "name" $obj.Name "namespace" $obj.Namespace "callerNamespace" .callerNamespace) }}
    {{- $minReplicas := 1 }}{{- if $obj.Spec | hasKey "minReplicas" }}{{- $minReplicas = $obj.Spec.minReplicas | toInt }}{{- end }}
    {{- $current := $obj.Status.currentReplicas | default 0 | toInt }}
    {{- $desired := $obj.Status.desiredReplicas | default 0 | toInt }}
    {{- printf ", %d" $current | redBoldIf (ne $current $desired) }}/{{ printf "%d-%d" $minReplicas ($obj.Spec.maxReplicas | toInt) }}
    {{- if ne $current $desired }}, {{ "desired" | yellow | bold }}: {{ printf "%d" $desired | yellow }}{{ end }}
    {{- template "kstatus_if_abnormal" $obj }}
    {{- /* Same scan other_unhealthy_conditions does, minus ScalingLimited: its inverted
           polarity (False = normal) would flag every healthy HPA as unhealthy. A True
           value is a bound, not a fault, so it surfaces as a yellow marker instead. */ -}}
    {{- $entries := list }}
    {{- range $obj.StatusConditions }}
        {{- if and .type (ne .type "Ready") (ne .type "ScalingLimited") (not (isStatusConditionHealthy .)) }}
            {{- $entries = $entries | append ((coalesce .reason .message (printf "%s:%s" .type (.status | default "Unknown" | toString))) | red | bold) }}
        {{- end }}
    {{- end }}
    {{- $scalingLimited := getMatchingItemInMapList (dict "type" "ScalingLimited") $obj.StatusConditions }}
    {{- if $scalingLimited }}{{ if eq ($scalingLimited.status | default "" | toString) "True" }}
        {{- $entries = $entries | append ("scaling-limited" | yellow | bold) }}
    {{- end }}{{ end }}
    {{- with $entries }}, {{ . | join ", " }}{{ end }}
{{- end -}}
