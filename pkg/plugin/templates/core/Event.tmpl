{{- define "Event" }}
  {{- /*gotype: github.com/bergerx/kubectl-status/pkg/plugin.RenderableObject*/ -}}
  {{- template "status_summary_line" . }}
  {{ template "event" (dict "event" .Unstructured.Object "showInvolvedObject" true) }}
{{- end }}

{{- define "event" }}
    {{- /* Expects dict "event" (one raw Event object's fields) "showInvolvedObject" (optional bool).
           Set only for a standalone Event resource (`k get events`), where the involved object
           isn't already implied by the surrounding output; left unset when listing events nested
           under another resource's own Events: section (`k get pods`, etc), where repeating
           "involving Kind/name" would just echo the resource already on screen -- see #829. When
           shown, the involved object is rendered via resource_ref rather than by hand so it gets
           the same Kind/name/-n namespace formatting as every other cross-reference. */ -}}
    {{- $e := .event }}
    {{- list $e.reportingInstance $e.source.host $e.reportingComponent $e.source.component $e.source.fieldPath | compact | uniq | join "," | bold }}
    {{- if eq $e.type "Warning" }} {{ $e.reason | red | bold }}{{ else }} {{ $e.reason | bold }}{{ end -}}
    {{- with $e.action}} {{ . }}{{end}}
    {{- if .showInvolvedObject }}
        {{- with $e.involvedObject }} involving {{ template "resource_ref" (dict "kind" .kind "name" .name "namespace" .namespace) }}
            {{- with .fieldPath }}[{{ . }}]{{ end }}
        {{- end }}
    {{- end }}
    {{- with $e.lastTimestamp }} {{ . | colorAgo }}{{ agoSuffix }}{{ end }}
    {{- if gt ($e.count | toInt) 1 -}}
        {{- if $e.firstTimestamp }} (x{{ $e.count }} over {{ $e.firstTimestamp | colorAgo }})
        {{- else }} (x{{ $e.count }})
        {{- end -}}
    {{- end -}}
    {{- " " }}{{ $e.message }}
{{- end -}}
